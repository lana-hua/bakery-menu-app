<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Donut Image - Use Android's built-in icon for testing -->
    <ImageView
        android:id="@+id/donutImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/btn_star" />

    <!-- Donut Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <!-- Donut Name -->
        <TextView
            android:id="@+id/donutName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plain Donut"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Donut Type -->
        <TextView
            android:id="@+id/donutType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yeast Donut"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />

        <!-- Donut Price -->
        <TextView
            android:id="@+id/donutPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$1.99"
            android:textSize="16sp"
            android:textColor="#4CAF50" />

        <!-- Quantity (Optional - can be hidden initially) -->
        <TextView
            android:id="@+id/donutQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qty: 0"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>