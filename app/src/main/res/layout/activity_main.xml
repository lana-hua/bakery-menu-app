<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:backgroundTint="@color/cream">

    <ImageView
        android:id="@+id/myImageView"
        android:layout_width="wrap_content"
        android:layout_height="165dp"
        android:contentDescription="Description of the image"
        android:src="@drawable/donutmain" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RU Donuts!"
        android:textSize="60sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"
        android:textColor="@color/medpink" />

    <Button
        android:id="@+id/btnCoffee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Order Coffee"
        android:textSize="20sp"
        android:layout_marginBottom="20dp"
        android:padding="16dp"
        android:backgroundTint="@color/lightpink"/>

    <Button
        android:id="@+id/btnDonut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Order Donuts"
        android:textSize="20sp"
        android:layout_marginBottom="20dp"
        android:padding="16dp"
        android:backgroundTint="@color/lightpink"/>

    <Button
        android:id="@+id/btnSandwich"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Order Sandwich"
        android:textSize="20sp"
        android:layout_marginBottom="20dp"
        android:padding="16dp"
        android:backgroundTint="@color/lightpink"/>

    <Button
        android:id="@+id/btnOrders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Orders"
        android:textSize="20sp"
        android:padding="16dp"
        android:backgroundTint="@color/lightpink"/>

</LinearLayout>
